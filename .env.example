# 🔧 Configuración para Render - Optimizada contra SIGTERM
NODE_ENV=production

# 🚀 Optimizaciones de Node.js para Render
NODE_OPTIONS=--max-old-space-size=1024 --optimize-for-size
UV_THREADPOOL_SIZE=16

# ⏱️ Timeouts aumentados para estabilidad
INACTIVITY_TIMEOUT_MS=300000
RECOVERY_428_WAIT_MS=15000

# 🛡️ Configuraciones de lock y recovery
LOCK_LEASE_MS=120000
LOCK_RENEW_MS=60000

# 📊 Configuraciones de scoring (ya optimizadas)
DEST_SCORE_MIN_LIST=0.65
DEST_SCORE_MIN_AUTO=0.85
METODO_PAGO_SCORE_MIN_LIST=0.60
METODO_PAGO_SCORE_MIN_AUTO=0.85

# 🔐 Variables sensibles (configurar en Render Dashboard)
# MONGO_URI=mongodb+srv://...
# SUPABASE_URL=https://...
# SUPABASE_ANON_KEY=...
# ALLOWED_JIDS=...
# NUMBER_1_ALLOWED=...

# 🏗️ Configuraciones de build
PORT=8000
BAILEYS_INSTANCE=render-production